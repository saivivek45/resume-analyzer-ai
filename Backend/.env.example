# ===========================
# BACKEND ENVIRONMENT VARIABLES
# ===========================

# PostgreSQL Database URL
# Local: postgresql://postgres:postgres@localhost:5432/careerpilot
# Production (Render): Copy from your Render PostgreSQL dashboard
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careerpilot

# Security - Random Secret Key
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MUST change in production!
SECRET_KEY=replace-with-a-long-random-secret

# JWT Token Expiration (days)
JWT_EXPIRE_DAYS=7

# Google OAuth Configuration
# Get from Google Cloud Console: https://console.cloud.google.com
# Must be registered as OAuth 2.0 Web Application
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Google Gemini API for Resume Analysis
# Get from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key

# SMTP Configuration (Email Verification)
# For Gmail: Create app-specific password at https://myaccount.google.com/apppasswords
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=true

# Cookie Security
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false

# Frontend URL (CORS Configuration)
# Local: http://localhost:3000
# Production: https://your-vercel-domain.vercel.app
FRONTEND_URL=http://localhost:3000

# Application Mode
DEBUG=false
