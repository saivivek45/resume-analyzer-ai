# ===========================
# BACKEND ENVIRONMENT VARIABLES (Render)
# ===========================

# PostgreSQL Database URL
# Format: postgresql://user:password@host:port/dbname
# For Render: Copy from your Render PostgreSQL dashboard
DATABASE_URL=postgresql://user:password@localhost:5432/careerpilot

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT Configuration
JWT_EXPIRE_DAYS=7

# Google OAuth
# Get from Google Cloud Console: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Gemini API for Resume Analysis
# Get from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key

# SMTP Configuration (for email verification)
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true

# Frontend URL (for CORS)
# Set to your Vercel domain in production
FRONTEND_URL=http://localhost:3000

# Application Mode
DEBUG=false
COOKIE_SECURE=false

# ===========================
# FRONTEND ENVIRONMENT VARIABLES (Vercel)
# ===========================

# Backend API URL
# Set to your Render backend domain in production
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth Client ID (same as backend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Application URL (for redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
